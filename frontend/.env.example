# Leave empty when using Vite's local proxy to http://localhost:8080.
# For a separately hosted backend, set the full API origin, e.g. https://api.example.com
VITE_API_URL=

# Optional browser-only Azure Speech configuration used by the existing voice-assist UI.
VITE_AZURE_SPEECH_KEY=
VITE_AZURE_SPEECH_REGION=
