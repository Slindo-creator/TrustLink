# Spring Boot backend
PORT=8080
FRONTEND_ORIGINS=http://localhost:5173

# Required secrets
SUPABASE_DB_PASSWORD=
JWT_SECRET=

# Optional
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_DAYS=30
VERIFICATION_UPLOAD_DIR=./uploads/verification
MAX_VERIFICATION_FILE_SIZE_BYTES=5242880
AUTH_RATE_LIMIT=10
